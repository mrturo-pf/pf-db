# Template for scripts/export-neon-dump.sh
#
# Copy this to secrets/neon.env (gitignored) and fill in your real Neon
# connection string. Get it from the Neon dashboard -> Connect -> "psql"
# tab (or your DATABASE_URL in ../.env if you already have it there).
#
# Must be a plain "postgresql://" URL (not "postgresql+asyncpg://") since
# it's consumed by pg_dump/psql, not SQLAlchemy.
NEON_DATABASE_URL=postgresql://neondb_owner:change-me@your-project-pooler.region.aws.neon.tech/pf_db?sslmode=require
